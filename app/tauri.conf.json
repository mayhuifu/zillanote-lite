{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZillaNote",
  "version": "0.1.0",
  "identifier": "com.zillanote.lite",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZillaNote",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/llama-server/": "llama-server/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
